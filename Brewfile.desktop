# Brewfile.desktop — Pro 専用（重量級・据置用途）
#
# setup.sh は本ファイルを呼ばない。必要な時に手で:
#   brew bundle install --file=~/dotfiles/Brewfile.desktop
#
# 持ち運び機（Air）には入れない。
# Xcode は Air では Command Line Tools のみ入れる。
#
# 意図的に外した cask（2026-10-27 の棚卸し）。Pro にはまだ入っているので `brew bundle dump` には出てくるが、
#   差分を反映するときに戻さない。使っているかは `bash tools/brewfile-usage.sh` で確かめた。
#   .app を削除済み:      adobe-digital-editions（Rosetta 2 も必須だった） aqua-voice chatgpt chatgpt-atlas
#                         phpstorm tor-browser vivaldi
#   1 年以上使っていない: microsoft-edge minecraft steam zen
#   使っていない:         cursor warp local mamp（local と mamp は前々職の遺産）

brew "ideviceinstaller"
brew "ios-deploy"
brew "libimobiledevice"
brew "mingw-w64"
brew "openvino"
cask "adobe-creative-cloud"
cask "blackhole-16ch"
cask "blackhole-2ch"
cask "handbrake-app"
cask "kiro-cli"
mas "Xcode", id: 497799835
