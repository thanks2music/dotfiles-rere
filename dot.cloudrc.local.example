# ~/.cloudrc.local — GCP / Firebase のプロジェクト識別子。
#
# このファイルは *.local なので gitignore されている（= 2 台目には届かない）。
# 値は avengers の暗号アーカイブ (migrate/export.sh) 経由で運ぶ。
#
# なぜ .example が必要か:
#   変数名の一覧を残すため。値は avengers の暗号アーカイブから入る。
#
# なぜ export をコメントアウトしてあるか (重要):
#   当初は `export VAR=""` と空文字を入れていたが、これは逆効果だった。
#   `set -u` は「未定義」を検知するが「空文字」は通してしまうため、
#   空文字を入れると `gcloud --project=""` が静かに通り、gcloud の active
#   configuration の既定プロジェクトを意図せず対象にしうる。実測:
#
#     未定義 + set -u → "unbound variable" で停止 (exit 非ゼロ)
#     空文字 + set -u → 通過 (exit 0)
#
#   コメントアウトしておけば変数名は文書化され、値が無い状態は未定義のまま残るので
#   deploy スクリプト側の set -u が大きな音を立てて止まる。

# --- Revolution ---
# export REVO_PROJECT_ID=
# export REVO_REGION=
# export REVO_DB_INSTANCE_NAME=
# export REVO_DB_NAME=
# export REVO_DB_USER=
# export REVO_BUCKET_NAME=
# export REVO_PLUGINS_BUCKET_NAME=
# export REVO_ARTIFACT_REPO_NAME=
# export REVO_SERVICE_NAME=
# export REVO_FIREBASE_SERVICE_ACCOUNT_PATH=

