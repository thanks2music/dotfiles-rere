# ~/.cloudrc.local — GCP / Firebase のプロジェクト識別子。
#
# このファイルは *.local なので gitignore されている（= 2 台目には届かない）。
# 値は avengers の暗号アーカイブ (migrate/export.sh) 経由で運ぶ。
#
# なぜ .example が必要か:
#   これが無いと新しい Mac で ~/.cloudrc.local がファイルごと存在せず、21 個の変数が
#   すべて未定義になる。その状態で deploy スクリプトを走らせると
#   `gcloud --project=""` のように空値で実行され、gcloud の active configuration の
#   既定プロジェクトを意図せず対象にしうる。空でもファイルが在れば気づける。

# --- Revolution ---
export REVO_PROJECT_ID=""
export REVO_REGION=""
export REVO_DB_INSTANCE_NAME=""
export REVO_DB_NAME=""
export REVO_DB_USER=""
export REVO_BUCKET_NAME=""
export REVO_PLUGINS_BUCKET_NAME=""
export REVO_ARTIFACT_REPO_NAME=""
export REVO_SERVICE_NAME=""
export REVO_FIREBASE_SERVICE_ACCOUNT_PATH=""

# --- dev-crd-wp ---
export DEV_CRD_WP_PROJECT_ID=""
export DEV_CRD_WP_PROJECT_NUMBER=""
export DEV_CRD_WP_REGION=""
export DEV_CRD_WP_DB_INSTANCE_NAME=""
export DEV_CRD_WP_DB_NAME=""
export DEV_CRD_WP_DB_NAME_SECRET=""
export DEV_CRD_WP_DB_USER=""
export DEV_CRD_WP_DB_USER_SECRET=""
export DEV_CRD_WP_BUCKET_NAME=""
export DEV_CRD_WP_ARTIFACT_REPO_NAME=""
export DEV_CRD_WP_SERVICE_NAME=""
